# Replace each value with a stable, private seed phrase before first run.
# Keep the resulting .env file local; it is ignored by git.
BP_SEED_ORCHESTRATOR=replace-with-private-stable-seed
BP_SEED_PARSER=replace-with-private-stable-seed
BP_SEED_SEARCH_ZEPTO_MOCK=replace-with-private-stable-seed
BP_SEED_SEARCH_INSTAMART_MOCK=replace-with-private-stable-seed
BP_SEED_SEARCH_ZEPTO=replace-with-private-stable-seed
BP_SEED_OPTIMIZER=replace-with-private-stable-seed
BP_SEED_CHECKOUT=replace-with-private-stable-seed
BP_SEED_TERMINAL=replace-with-private-stable-seed

BP_USE_MOCK=true
BP_MAILBOX=false
BP_ALLOW_CART_WRITES=false
BP_ALLOW_ORDERS=false
BP_SESSION_DB=data/sessions.sqlite3
ZEPTO_ADDRESS_ID=
